{
  "manifest_version": 3,
  "name": "Side Panel Extension",
  "version": "2.20.3",
  "description": "QA Assist Side Panel Extension",

  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "sidePanel"
  ],

  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background.js"
  },

  "side_panel": {
    "default_path": "index.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentScript.js"],
      "run_at": "document_idle"
    }
  ]
}